Algoritmo CantidadNumeros
	// 3 Leer n�meros hasta que escriban 0 y mostrar cu�ntos se ingresaron.
	Definir num, contador  Como Entero
	contador <- 1 
	num <- 12
	Mientras num <> 0 Hacer
		Escribir "Ingrese el numero ", contador
		Leer num 
		contador <- contador + 1
	FinMientras
FinAlgoritmo
